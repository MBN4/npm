PORT=5000
HOST=0.0.0.0
NODE_ENV=production
JWT_SECRET=replace-with-a-long-random-secret
DB_PATH=/app/data/nmp.sqlite

# Optional: AI invoice reader for Purchases > "AI Stock Inward". Set ONE key (Groq is used first).
# Never commit real keys. On Fly.io use: fly secrets set GROQ_API_KEY=... -a nmp-api
GROQ_API_KEY=
# GEMINI_API_KEY=
# Optional model overrides. Normally not needed: the server picks a model your key can use.
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# GROQ_TEXT_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash
