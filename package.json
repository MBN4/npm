{
  "name": "nmp-pharmacy-system",
  "version": "1.0.0",
  "description": "Naveed Medical Pharmacy (NMP) Management System",
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "npm --prefix server run dev",
    "server:seed": "npm --prefix server run seed",
    "server:test": "npm --prefix server run test",
    "client:dev": "npm --prefix client run dev",
    "client:build": "npm --prefix client run build",
    "seed": "npm --prefix server run seed",
    "test": "npm --prefix server run test",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
